# ── 必需 ──────────────────────────────────────────────
# GLaDOS Cookie（多账号用 & 分隔）
GLADOS_COOKIES=koa:sess=xxx; koa:sess.sig=xxx

# ── 可选 ──────────────────────────────────────────────
# 兑换计划: plan100 / plan200 / plan500（默认 plan500）
GLADOS_EXCHANGE_PLAN=plan500

# 详细日志: true / false（默认 false）
GLADOS_VERBOSE=false

# 自定义域名（逗号分隔，默认 glados.cloud）
# GLADOS_DOMAINS=glados.cloud

# 重试次数（默认 3）
# GLADOS_RETRY_MAX=3

# 重试退避基数（秒，默认 2.0）
# GLADOS_RETRY_BACKOFF=2.0

# ── 推送通知 ───────────────────────────────────────────
# 渠道: telegram / bark / serverchan / pushplus / wecom / feishu
GLADOS_PUSH_CHANNEL=

# Token 格式见各渠道说明
GLADOS_PUSH_TOKEN=