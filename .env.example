# ── 必需 ──────────────────────────────────────────────
# GLaDOS Cookie（多账号用 & 分隔，也支持换行 / |）
# 字段名有两代：
#   新版（2024 后）: gld:sess / gld:sess.sig
#   老版（koa）:     koa:sess / koa:sess.sig
# 两套都支持。字段名跟服务端对不上会一律回 code=-2 没有权限，
# 与是否过期、IP 是否被封无关。
GLADOS_COOKIES=gld:sess=gld_xxxxxxxx; gld:sess.sig=xxxxxxxx

# ── 可选 ──────────────────────────────────────────────
# 兑换计划: plan100 / plan200 / plan500（默认 plan500）
GLADOS_EXCHANGE_PLAN=plan500

# 剩余天数低于此值才兑换（默认 7）
# GLADOS_EXCHANGE_MIN_DAYS=7

# 详细日志: true / false（默认 false）
GLADOS_VERBOSE=false

# 自定义域名（逗号分隔）。留空则自动按
# glados.cloud → glados.rocks → glados.work → glados.space → glados.la 探测
# GLADOS_DOMAINS=glados.cloud,glados.rocks

# 重试次数（默认 3）
# GLADOS_RETRY_MAX=3

# 重试退避基数（秒，默认 2.0）
# GLADOS_RETRY_BACKOFF=2.0

# ── 推送通知 ───────────────────────────────────────────
# 渠道: telegram / bark / serverchan / pushplus / wecom / feishu
GLADOS_PUSH_CHANNEL=

# Token 格式见各渠道说明
GLADOS_PUSH_TOKEN=
